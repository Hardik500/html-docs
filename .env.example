# Database connection string (Fly Postgres or local)
DATABASE_URL=postgres://moneytree:moneytree_dev_password@localhost:5432/html_docs_dev

# Secret for session cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-in-production

# Salt for IP address hashing in rate limits (generate with: openssl rand -hex 16)
IP_HASH_SALT=change-me-in-production

# Resend API key for magic-link emails (https://resend.com)
RESEND_API_KEY=re_...

# From email address for magic links
EMAIL_FROM=noreply@yourdomain.com

# Public app URL (used in magic link emails)
APP_URL=http://localhost:5173
