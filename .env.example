# Supabase PostgreSQL connection (use the "Direct connection" URL from Supabase dashboard)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase project credentials (Authentication → API in Supabase dashboard)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...

# Salt for IP address hashing in rate limits (generate with: openssl rand -hex 16)
IP_HASH_SALT=change-me-in-production

# Public app URL — must match Supabase "Site URL" setting
APP_URL=http://localhost:5173

# Optional path or inline PEM CA certificate when the database host is not in the system trust store.
# DATABASE_CA_CERT_PATH=/run/secrets/database-ca.pem
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----

# Hosted origin used by the Electron desktop client for cloud sync.
# Leave empty to build a local-only desktop app.
HTML_DOCS_REMOTE_URL=https://your-hosted-html-docs.example.com

# --- REMOVED ---
# SESSION_SECRET  (no longer needed — Supabase manages sessions)
# RESEND_API_KEY  (no longer needed — Supabase sends magic link emails)
# EMAIL_FROM      (no longer needed — configured in Supabase email templates)
